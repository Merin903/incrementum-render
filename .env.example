# Copy this file to .env and fill it in:   cp .env.example .env
# .env is private and is never committed to Git.

# ---- Database (default is fine) ----
DB_PATH=data/incrementum.db

# ---- WhatsApp via Twilio sandbox (leave WHATSAPP_ENABLED=false to stay in test mode) ----
WHATSAPP_ENABLED=false
# From the Twilio console home page (Account Info):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio sandbox WhatsApp number shown on the sandbox page (with or without the "whatsapp:" prefix):
TWILIO_WHATSAPP_FROM=+14155238886
# The sandbox sends at most one message every 3 seconds; this paces live sends (seconds).
WHATSAPP_MIN_INTERVAL=3

# ---- Phone numbers of people who AGREED to receive messages (international format) ----
DEMO_PHONE_MERIN=+910000000000
DEMO_PHONE_DELNA=+910000000000
DEMO_PHONE_HANNA=+910000000000
DEMO_PHONE_ANGEL=+910000000000
DEMO_PHONE_ADWOITH=+910000000000

# ---- Optional wording in messages ----
# SHOP_NAME=Incrementum Store
# MESSAGE_FOOTER=(Incrementum project test message)
